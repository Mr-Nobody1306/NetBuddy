# NEVER commit this file with a real key in it. It is git-ignored on purpose.
# Copy to a file named exactly `.env` and fill it in. The server reads it
# at startup. The browser can NEVER fetch this file (only public/ is served).

PORT=8000
AI_PROVIDER = openai
AI_BASE_URL = https://api.groq.com/openai/v1
AI_MODEL = openai/gpt-oss-120b
AI_API_KEY=PASTE_YOUR_KEY_HERE
